POCKETBASE_DIST_DIR=C:/Users/naved/Downloads/pocketbase_0.36.9_linux_amd64
APP_PUBLIC_URL=http://localhost:8080
POCKETBASE_APP_NAME=AI-BREAK
POCKETBASE_SUPERUSER_EMAIL=superuser@example.com
POCKETBASE_SUPERUSER_PASSWORD=change-this-password
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-this-password
POCKETBASE_MAIL_SENDER_NAME=AI-BREAK
POCKETBASE_MAIL_SENDER_ADDRESS=newsletter@example.com
# Leave blank to let the frontend use the same public origin as the app.
# The container nginx proxies /api/* and /_/ to the internal PocketBase process.
POCKETBASE_PUBLIC_URL=
POCKETBASE_SMTP_ENABLED=0
POCKETBASE_SMTP_HOST=smtp.example.com
POCKETBASE_SMTP_PORT=587
POCKETBASE_SMTP_USERNAME=
POCKETBASE_SMTP_PASSWORD=
POCKETBASE_SMTP_AUTH_METHOD=PLAIN
POCKETBASE_SMTP_TLS=0
POCKETBASE_SMTP_LOCAL_NAME=
POCKETBASE_RECREATE_COLLECTIONS=0
FRONTEND_PORT=8080
POCKETBASE_PORT=8090