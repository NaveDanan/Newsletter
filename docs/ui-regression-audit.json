bs(r.width-innerWidth)<1&&Math.abs(r.height-innerHeight)<1,{x:r.x,y:r.y,width:r.width,height:r.height});check('Gantt has independent scroll panes',a&&b&&css(a).overflowY==='auto'&&css(b).overflowY==='auto');if(a&&b){const original={a:a.scrollTop,b:b.scrollTop};b.scrollTop=1e5;await wait(100);check('vertical rows stay synchronized',Math.abs(a.scrollTop-b.scrollTop)<1&&Math.abs((a.scrollHeight-a.clientHeight)-(b.scrollHeight-b.clientHeight))<2);check('both headings remain frozen',Math.abs(rect(a.firstElementChild.firstElementChild).top-rect(a).top)<1&&Math.abs(rect(b.firstElementChild.firstElementChild).top-rect(b).top)<1);a.scrollTop=original.a;b.scrollTop=original.b;const names=[...a.querySelectorAll('input[type=text]')];check('task names get usable width',names.length>=5&&names.every(e=>rect(e).width>=110),names.map(e=>rect(e).width));check('task name text fits visible field',names.every(e=>{const c=document.createElement('canvas').getContext('2d');c.font=css(e).font;return c.measureText(e.value).width<=e.clientWidth-parseFloat(css(e).paddingLeft)-parseFloat(css(e).paddingRight)}));check('dates use compact 12px text',[...a.querySelectorAll('input[type=date]')].every(e=>css(e).fontSize==='12px'));check('horizontal scrollbar available',!!document.querySelector('[role=scrollbar][aria-controls=gantt-task-grid]'));}}return{route:location.pathname,theme:document.documentElement.dataset.theme,locale:document.documentElement.lang,width:innerWidth,tests};})()",
